# Data API base URL for governed fact tools
CIVILAI_DATA_API_BASE=http://localhost:8000

# UAT — EC2 data API (agent/eval against deployed snapshot 2026-07-02)
# CIVILAI_DATA_API_BASE=https://data-uat.example.com
# Athena-backed /determinations can exceed 30s; raise for local eval (e.g. 180)
CIVILAI_DATA_API_TIMEOUT=30

# Model provider: bedrock (default) or openai
CIVILAI_MODEL_PROVIDER=bedrock

# Bedrock model (Strands BedrockModel)
CIVILAI_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_PROFILE=civilai
AWS_DEFAULT_REGION=us-east-1

# Direct OpenAI model (Strands OpenAIModel) -- only used when CIVILAI_MODEL_PROVIDER=openai.
# Install with: uv sync --extra openai
# Bake-off vs Haiku: use flagship tier (gpt-5.2), not gpt-4o/mini/nano. GPT-5/o-series
# models reject custom temperature — openai_model.py omits it automatically.
OPENAI_API_KEY=
CIVILAI_OPENAI_MODEL_ID=gpt-5.2

# Optional: platform data proxy (when tools route through civil-ai-platform)
CIVILAI_PLATFORM_DATA_PROXY=

# Web search (optional, last-resort tool)
CIVILAI_WEB_SEARCH_PROVIDER=tavily
CIVILAI_TAVILY_API_KEY=
